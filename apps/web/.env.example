# Base de données — Docker Compose en local (défaut)
# DATABASE_URL sert à l'APPLICATION ; DIRECT_URL sert à la CLI Prisma
# (db push, db seed, migrations). Les deux valent la même chose en local :
# il n'y a pas de pooler. Voir plus bas la configuration Neon.
DATABASE_URL="postgresql://conso:conso@localhost:5432/conso_ci?schema=public"
DIRECT_URL="postgresql://conso:conso@localhost:5432/conso_ci?schema=public"

# ─── Neon (alternative managée, décommenter pour l'utiliser) ───────────────
# 1. `npx neonctl auth` puis `npx neonctl projects create --name conso-ci`
# 2. `npx neonctl connection-string` affiche les deux URLs
#
# DATABASE_URL = endpoint POOLED (contient « -pooler ») : utilisé par l'app.
#   `pgbouncer=true` est OBLIGATOIRE : le pooler Neon ne gère pas les
#   transactions interactives, Prisma doit adapter son protocole.
#   `connect_timeout=15` AbsORBE le cold start : le compute Neon se met en
#   veille après inactivité et il faut quelques secondes pour le réveiller.
#
# DIRECT_URL = endpoint DIRECT (SANS « -pooler ») : utilisée par la CLI Prisma.
#
# DATABASE_URL="postgresql://USER:PASSWORD@ep-xxx-pooler.eu-central-1.aws.neon.tech/conso_ci?sslmode=require&pgbouncer=true&connect_timeout=15"
# DIRECT_URL="postgresql://USER:PASSWORD@ep-xxx.eu-central-1.aws.neon.tech/conso_ci?sslmode=require"

# Secret de signature des sessions et de hachage des OTP — À REMPLACER EN PRODUCTION
AUTH_SECRET="dev-secret-conso-ci-change-me-in-production"

# Fournisseur SMS pour l'envoi du code OTP (flow.md §40).
# Sans ces variables, aucun SMS n'est envoyé : en développement le code
# s'affiche dans l'interface, en production l'utilisateur reçoit un message
# d'échec explicite plutôt qu'un faux succès.
SMS_PROVIDER_URL=""
SMS_PROVIDER_TOKEN=""

# Dossier de stockage des reçus — par défaut ./uploads
UPLOAD_DIR=""