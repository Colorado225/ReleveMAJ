# ConsoCI — variables d'environnement (flow.md §63).
# Copiez ce fichier vers apps/web/.env, qui est le fichier réellement lu par
# l'application Next.js (voir README « Démarrage »).

# Base de données locale (docker compose)
DATABASE_URL="postgresql://conso:conso@localhost:5432/conso_ci?schema=public"

# Secret de signature des sessions JWT et de hachage des OTP.
# OBLIGATOIRE. Générez-le avec : openssl rand -base64 48
AUTH_SECRET="dev-secret-conso-ci-change-me-in-production"

# Fournisseur SMS pour l'envoi du code OTP (flow.md §40).
# Variables absentes → aucun envoi ; en développement le code s'affiche dans
# l'interface, en production l'utilisateur reçoit un message d'échec explicite.
SMS_PROVIDER_URL=""
SMS_PROVIDER_TOKEN=""

# Dossier de stockage des reçus — défaut ./uploads
UPLOAD_DIR=""